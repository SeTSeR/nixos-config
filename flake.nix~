{
  description = "A NixOS configuration flake";

  inputs.nixpkgs.url = github:nixos/nixpkgs/nixos-unstable;

  outputs = { self, nixpkgs } @ inputs: {
    nixosConfigurations = {
      orangepi3 = nixpkgs.lib.nixosSystem {
        system = "aarch64-linux";
        modules = [
          ./configuration.nix
        ];
        specialArgs = { inherit inputs; };
      };
    };
  };
}
